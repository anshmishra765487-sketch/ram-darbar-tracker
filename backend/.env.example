# Copy this file to .env and change values as needed.

# --- Database ---
# App runs on in-memory storage when MongoDB is not reachable (data resets on restart).
MONGO_URI=mongodb://localhost:27017
DB_NAME=transport_db

# --- Auth ---
# true  = login required (default).
# false = no login screen, app opens directly (local testing only).
AUTH_REQUIRED=true
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=43200
ADMIN_EMAIL=owner@ramdarbar.com
# Your mobile number (10 digits). SMS OTPs are sent to this number.
ADMIN_PHONE=
# Password for the owner account. Never shown on the login screen -
# use mobile OTP or this password. Leaving it blank falls back to "ramdarbar123".
ADMIN_PASSWORD=ramdarbar123

# --- OTP (SMS only) ---
# Code valid for 5 minutes, locks after 5 wrong tries, 45s resend cooldown.
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45
OTP_LENGTH=6

# --- SMS gateway (required for real mobile OTP) ---
# One of: fast2sms | msg91 | twilio
# There is no demo/log mode. If this is unset the OTP request fails with HTTP 502
# and the code is never printed or returned.
SMS_PROVIDER=
SMS_TEMPLATE=Your Ram Darbar Tracker login OTP is {code}. Valid for {minutes} min.
# FAST2SMS_KEY=
# FAST2SMS_SENDER=TXTLNS
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# --- App ---
# The app always starts with an empty database. No demo data is seeded.
CORS_ORIGINS=http://localhost:5173